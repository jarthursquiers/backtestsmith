# Copy to .env for development. NEVER commit .env
# Get your key at https://massive.com/dashboard/keys
MASSIVE_API_KEY=

# ThetaData Options Value API key (used for historical one-minute NBBO quotes)
THETADATA_API_KEY=

# Optional: override default requests-per-minute (free Options Basic tier = 5)
MASSIVE_RPM=5

# Optional: Schwab market-data credentials for SPX index history.
# Normally entered in the app (encrypted via the OS keystore); these env vars
# override the stored values and are intended for development only.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1:5173/callback
